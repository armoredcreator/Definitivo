# Copy into an isolated workspace only. No operational credentials belong here.
ARMORED_REAL_TELEGRAM=0
ARMORED_HUB_DRY_RUN=1
# Caption generation is local and deterministic; it does not require Ollama or Gemini.
ARMORED_IA_CAPTION_TITLE_RULES=1

# For the real Telegram Coordinator, configure exactly three source/destination pairs.
# Keep credentials in credentials/project.env; do not commit credentials.
# ARMORED_REAL_TELEGRAM=1
# ARMORED_REQUIRED_SOURCE_COUNT=3
# TELEGRAM_API_ID=<your Telegram API ID>
# TELEGRAM_API_HASH=<your Telegram API hash>
# ARMORED_SOURCE_1_CHAT_ID=<source chat 1>
# ARMORED_SOURCE_1_ID=<stable source id 1>
# ARMORED_HUB_1_CHAT_ID=<destination chat 1>
# ARMORED_HUB_1_TOPIC_ID=<destination topic 1>
# Repeat SOURCE_2/HUB_2 and SOURCE_3/HUB_3 with distinct routes.
# The executable validates routes without contacting Telegram; real Hub sends
# require the explicit --publish command-line switch.
# Live Shopee Affiliate API lookups require an explicit, time-bounded quota
# recorded in storage/database/shopee-query-budget.sqlite3. Each outbound HTTP
# attempt, including retries and short-link generation, consumes one request.
# Without a current authorization Vision records WAITING_VISION and downloads
# nothing. Never copy an expired research budget into this configuration.
# ARMORED_SHOPEE_QUERY_BUDGET_ID=
# ARMORED_SHOPEE_QUERY_LIMIT=
# ARMORED_SHOPEE_QUOTA_EVIDENCE=
# ARMORED_SHOPEE_QUOTA_VALID_UNTIL=
# ARMORED_SHOPEE_QUERY_LEDGER_PATH=storage/database/shopee-query-budget.sqlite3
# Optional trusted read-only source for historical originals; files are copied only when selected at Stock.
ARMORED_LEGACY_MEDIA_ROOT=
